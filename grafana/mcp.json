{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "-e",
        "GRAFANA_ORG_ID",
        "-e",
        "GRAFANA_EXTRA_HEADERS",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "GRAFANA_URL_ENV_VAR",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "GRAFANA_SERVICE_ACCOUNT_TOKEN_ENV_VAR"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
